# Racik POS — aturan akses situs purwarupa
# Dokumentasi & berkas internal tidak boleh dibuka publik (403 Forbidden).

# Jangan tampilkan daftar isi folder.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Berkas & folder tersembunyi (.git, .htaccess, .env, …), kecuali verifikasi SSL.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Folder dokumentasi pengembangan.
  RewriteRule ^docs(/|$) - [F,L]

  # Semua berkas Markdown (README.md, dll.) dan konfigurasi PHP.
  RewriteRule \.md$ - [F,L,NC]
  RewriteRule (^|/)php\.ini$ - [F,L,NC]
</IfModule>

# Lapis kedua bila mod_rewrite tidak aktif.
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)\.(md|ini)$">
    Require all denied
  </FilesMatch>
</IfModule>
