# Racik POS — aturan akses situs
# Aplikasi (index.html + assets/) dan API (api/index.php) boleh diakses publik.
# Dokumentasi, kode sumber API, migrasi, dan berkas internal: 403 Forbidden.

# Jangan tampilkan daftar isi folder.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Berkas & folder tersembunyi (.git, .htaccess, .env, …), kecuali verifikasi SSL.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Folder dokumentasi & alat pengembangan.
  RewriteRule ^(docs|tools)(/|$) - [F,L]

  # Kode sumber, skrip CLI, dan migrasi API tidak boleh dibuka langsung.
  RewriteRule ^api/(src|bin|migrations)(/|$) - [F,L]

  # Semua berkas Markdown, SQL, dan konfigurasi PHP.
  RewriteRule \.(md|sql)$ - [F,L,NC]
  RewriteRule (^|/)php\.ini$ - [F,L,NC]

  # Semua permintaan /api/* ditangani satu front controller.
  RewriteRule ^api/index\.php$ - [L]
  RewriteRule ^api(/.*)?$ api/index.php [L,QSA]
</IfModule>

# Lapis kedua bila mod_rewrite tidak aktif.
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)\.(md|ini|sql|log)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Skrip hanya dari situs ini (tidak ada skrip inline); gaya inline dipakai komponen UI; font dari Google Fonts.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  # Paksa HTTPS selama 180 hari (diabaikan browser bila respons bukan HTTPS).
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
